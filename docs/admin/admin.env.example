# Bind only to loopback; nginx is the public TLS boundary.
ANESTET_ADMIN_HOST=127.0.0.1
ANESTET_ADMIN_PORT=4318

# Exact public origin. Requests with another Origin are rejected.
ANESTET_ADMIN_ORIGIN=https://example.com

# Never commit real credentials. Password hash format is documented in README.md.
ANESTET_ADMIN_USERNAME=
ANESTET_ADMIN_PASSWORD_HASH=

ANESTET_CATALOG_STORE=/var/lib/anestet/catalog.json
ANESTET_ADMIN_AUDIT_STORE=/var/lib/anestet/admin-audit.jsonl
ANESTET_ADMIN_COOKIE_NAME=anestet_admin_session
ANESTET_ADMIN_COOKIE_SECURE=true
ANESTET_ADMIN_SESSION_HOURS=8
ANESTET_ADMIN_MAX_BODY_BYTES=65536

# Future connectors. Values are read only by the server-side admin service.
# Keep credentials in /etc/anestet/admin-api.env with mode 0600.
ONEC_API_URL=
ONEC_API_TOKEN=

CDEK_API_URL=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

ANESTET_CONNECTOR_URL=
ANESTET_CONNECTOR_TOKEN=
