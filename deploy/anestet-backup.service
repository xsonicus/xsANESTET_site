[Unit]
Description=Back up ANESTET catalog, audit, orders and callbacks

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/anestet-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/anestet
ReadWritePaths=/var/backups/anestet
